# Chat Configuration
# 
# The chat integration allows you to embed an external chat application
# into your application, either as a popup widget or as a full-page view.
#
# Configuration:
#
# CHAT_ENABLED - Enable/disable the chat feature (true/false)
# CHAT_URL - The URL of the chat application to embed (e.g., http://localhost:5001)
# CHAT_MODE - Display mode: 'popup' (floating widget) or 'fullpage' (dedicated page at /chat)
# CHAT_TITLE - The title shown in the chat interface
#
# Examples:
#
# For a local development chat server:
# CHAT_ENABLED=true
# CHAT_URL=http://localhost:5001
# CHAT_MODE=fullpage
# CHAT_TITLE="Support Chat"
#
# For a production chat service:
# CHAT_ENABLED=true
# CHAT_URL=https://chat.yourcompany.com
# CHAT_MODE=popup
# CHAT_TITLE="Help & Support"
#
# To disable chat:
# CHAT_ENABLED=false

CHAT_ENABLED=false
CHAT_URL=http://localhost:5001
CHAT_MODE=fullpage
CHAT_TITLE=Chat
